{
  "name": "nav-stack-lab",
  "version": "79.0.0",
  "description": "A browser simulator for robot navigation: localization, perception, planning and control, with loop analysis and guided lessons, in one HTML file.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spz0git/nav-stack-lab.git"
  },
  "homepage": "https://spz0git.github.io/nav-stack-lab/",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "lint": "eslint .",
    "fmt": "prettier --write \"src/**/*.js\" \"src/**/*.css\" build.mjs \"tools/*.mjs\" \"tests/node/*.mjs\" eslint.config.mjs",
    "fmt:check": "prettier --check \"src/**/*.js\" \"src/**/*.css\" build.mjs \"tools/*.mjs\" \"tests/node/*.mjs\" eslint.config.mjs",
    "test": "node --test \"tests/node/*.test.mjs\"",
    "test:browser": "python3 tests/run_all.py",
    "test:all": "npm test && npm run test:browser",
    "golden": "node tests/node/core.mjs --write-golden",
    "version:check": "node tools/version-check.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
